pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = "590396427103.dkr.ecr.us-east-1.amazonaws.com"
        AWS_DEFAULT_REGION = "us-east-1"
        GIT_COMMIT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
        SONAR_PROJECT_API_GATEWAY = "cinevision_api-gateway"
        SONAR_PROJECT_USER_SERVICE = "cinevision_user-service"
        SONAR_PROJECT_MOVIE_SERVICE = "cinevision_movie-service"
        SONAR_PROJECT_EMAIL_SERVICE = "cinevision_email-service"
        SONAR_PROJECT_EUREKA = "cinevision_eureka-server"
        // We'll set these in the Initialize stage
        HAS_SERVICES = "false"
        ACTIVE_SERVICES_JSON = "{}"
        BUILT_SERVICES_JSON = "[]"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('ECR Login') {
            steps {
                withCredentials([[
                    $class: 'UsernamePasswordMultiBinding',
                    credentialsId: 'ecr-cred',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        sh """
                            aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | \
                            docker login --username AWS --password-stdin ${DOCKER_REGISTRY}
                        """
                    }
                }
            }
        }

        stage('Initialize') {
            steps {
                script {
                    def possibleServices = [
                        'api-gateway':   [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_API_GATEWAY ],
                        'user-service':  [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_USER_SERVICE ],
                        'movie-service': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_MOVIE_SERVICE ],
                        'email-service': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_EMAIL_SERVICE ],
                        'eureka-server': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_EUREKA ],
                        'frontend':      [ type: 'frontend', buildFile: 'package.json', sonarKey: null ]
                    ]
                    def activeServices = [:]
                    possibleServices.each { serviceName, config ->
                        def servicePath = "services/${serviceName}"
                        if (fileExists("${servicePath}/${config.buildFile}")) {
                            activeServices[serviceName] = config
                            echo "Service ${serviceName} is active and will be built."
                        } else {
                            echo "Service ${serviceName} is NOT active (missing ${config.buildFile}). Skipping."
                        }
                    }
                    // Store as JSON strings in environment variables
                    env.ACTIVE_SERVICES_JSON = groovy.json.JsonOutput.toJson(activeServices)
                    env.HAS_SERVICES = activeServices.isEmpty() ? "false" : "true"
                    env.BUILT_SERVICES_JSON = "[]"

                    // Debug: print the values
                    echo "HAS_SERVICES = ${env.HAS_SERVICES}"
                    echo "ACTIVE_SERVICES_JSON = ${env.ACTIVE_SERVICES_JSON}"
                }
            }
        }

        stage('Build, Test & Sonar Analysis') {
            when { expression { env.HAS_SERVICES == 'true' } }
            steps {
                script {
                    def activeServices = groovy.json.JsonOutput.fromJson(env.ACTIVE_SERVICES_JSON)
                    def builtServices = []
                    def parallelStages = [:]

                    activeServices.each { serviceName, config ->
                        // Capture the service name in a local variable to avoid closure issues
                        def svc = serviceName
                        def cfg = config
                        parallelStages[svc] = {
                            stage("Build ${svc}") {
                                dir("services/${svc}") {
                                    if (cfg.type == 'backend') {
                                        sh 'mvn clean compile test'
                                        withSonarQubeEnv('sonarcloud') {
                                            sh "mvn sonar:sonar -Dsonar.projectKey=${cfg.sonarKey} -Dsonar.organization=cinevision"
                                        }
                                        sh 'mvn package'
                                        sh "docker build -t ${DOCKER_REGISTRY}/${svc}:${GIT_COMMIT} ."
                                        sh "docker push ${DOCKER_REGISTRY}/${svc}:${GIT_COMMIT}"
                                    } else if (cfg.type == 'frontend') {
                                        sh 'npm install'
                                        sh 'npm run build'
                                        sh "docker build -t ${DOCKER_REGISTRY}/${svc}:${GIT_COMMIT} ."
                                        sh "docker push ${DOCKER_REGISTRY}/${svc}:${GIT_COMMIT}"
                                    }
                                    builtServices << svc
                                }
                            }
                        }
                    }
                    parallel parallelStages
                    // Store built services list for later stages
                    env.BUILT_SERVICES_JSON = groovy.json.JsonOutput.toJson(builtServices)
                    echo "Built services: ${env.BUILT_SERVICES_JSON}"
                }
            }
        }

        stage('Wait for SonarQube Quality Gate') {
            when { expression { env.HAS_SERVICES == 'true' } }
            steps {
                script {
                    def builtServices = groovy.json.JsonOutput.fromJson(env.BUILT_SERVICES_JSON)
                    def activeServices = groovy.json.JsonOutput.fromJson(env.ACTIVE_SERVICES_JSON)
                    builtServices.each { serviceName ->
                        def config = activeServices[serviceName]
                        if (config.type == 'backend') {
                            timeout(time: 10, unit: 'MINUTES') {
                                waitForQualityGate abortPipeline: true, credentialsId: 'sonarcloud-token'
                            }
                        }
                    }
                }
            }
        }

        stage('Security Scan (Trivy)') {
            when { expression { env.HAS_SERVICES == 'true' } }
            steps {
                script {
                    docker.image('aquasec/trivy:latest').inside {
                        def builtServices = groovy.json.JsonOutput.fromJson(env.BUILT_SERVICES_JSON)
                        builtServices.each { serviceName ->
                            sh "trivy image --severity HIGH,CRITICAL ${DOCKER_REGISTRY}/${serviceName}:${GIT_COMMIT}"
                        }
                    }
                }
            }
        }

        stage('Update Kustomize') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.HAS_SERVICES == 'true' }
                }
            }
            steps {
                script {
                    def builtServices = groovy.json.JsonOutput.fromJson(env.BUILT_SERVICES_JSON)
                    builtServices.each { serviceName ->
                        sh """
                            cd k8s/overlays/dev
                            kustomize edit set image ${serviceName}=${DOCKER_REGISTRY}/${serviceName}:${GIT_COMMIT}
                        """
                    }
                    sh """
                        git config user.email "jenkins@cinevision.com"
                        git config user.name "Jenkins"
                        git add k8s/overlays/dev/
                        git commit -m "Update images for commit ${GIT_COMMIT}" || echo "No changes to commit"
                        git push origin HEAD:develop
                    """
                }
            }
        }

        stage('ArgoCD Sync') {
            when {
                allOf {
                    branch 'develop'
                    expression { env.HAS_SERVICES == 'true' }
                }
            }
            steps {
                echo "ArgoCD will automatically sync the changes"
                // Optionally, you could call argocd CLI here
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo " Build succeeded"
        }
        failure {
            echo " Build failed"
        }
    }
}