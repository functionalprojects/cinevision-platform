pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        DOCKER_REGISTRY = "590396427103.dkr.ecr.us-east-1.amazonaws.com"
        AWS_DEFAULT_REGION = "us-east-1"
        GIT_COMMIT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
        SONAR_PROJECT_API_GATEWAY = "cinevision_api-gateway"
        SONAR_PROJECT_USER_SERVICE = "cinevision_user-service"
        SONAR_PROJECT_MOVIE_SERVICE = "cinevision_movie-service"
        SONAR_PROJECT_EMAIL_SERVICE = "cinevision_email-service"
        SONAR_PROJECT_EUREKA = "cinevision_eureka-server"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('ECR Login') {
            steps {
                withCredentials([[
                    $class: 'UsernamePasswordMultiBinding',
                    credentialsId: 'ecr-cred',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        sh """
                            aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | \
                            docker login --username AWS --password-stdin ${DOCKER_REGISTRY}
                        """
                    }
                }
            }
        }

        stage('Initialize') {
            steps {
                script {
                    // Define all possible services with their type and build file
                    def possibleServices = [
                        'api-gateway':   [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_API_GATEWAY ],
                        'user-service':  [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_USER_SERVICE ],
                        'movie-service': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_MOVIE_SERVICE ],
                        'email-service': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_EMAIL_SERVICE ],
                        'eureka-server': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_EUREKA ],
                        'frontend':      [ type: 'frontend', buildFile: 'package.json', sonarKey: null ]
                    ]

                    // Determine which services are active (build file exists)
                    def activeServices = [:]
                    possibleServices.each { serviceName, config ->
                        def servicePath = "services/${serviceName}"
                        if (fileExists("${servicePath}/${config.buildFile}")) {
                            activeServices[serviceName] = config
                            echo "Service ${serviceName} is active."
                        } else {
                            echo "Service ${serviceName} is NOT active (missing ${config.buildFile}). Skipping."
                        }
                    }

                    // Detect changed services by comparing current commit with previous build commit
                    def changedServices = [:]
                    def prevCommit = env.GIT_PREVIOUS_COMMIT ?: ''
                    def currCommit = env.GIT_COMMIT

                    if (prevCommit == '') {
                        // First build – assume all active services have changed
                        echo "No previous commit found. Assuming all active services have changed."
                        changedServices = activeServices
                    } else {
                        echo "Comparing changes between ${prevCommit} and ${currCommit}"
                        // Get list of changed files
                        def changedFiles = sh(script: "git diff --name-only ${prevCommit} ${currCommit}", returnStdout: true).trim().split('\n')
                        // For each changed file, check which service directory it belongs to
                        def affectedServices = [] as Set
                        changedFiles.each { file ->
                            if (file.startsWith('services/')) {
                                def parts = file.split('/')
                                if (parts.size() >= 2) {
                                    def svcName = parts[1]
                                    if (activeServices.containsKey(svcName)) {
                                        affectedServices.add(svcName)
                                    }
                                }
                            }
                            // Optionally handle changes in shared directories (e.g., 'common', 'libs')
                            // For simplicity we only track per-service directories
                        }
                        // Build changedServices map from activeServices that are affected
                        affectedServices.each { svcName ->
                            changedServices[svcName] = activeServices[svcName]
                            echo "Service ${svcName} has changed and will be rebuilt."
                        }
                        // Also include services that are new (no previous commit comparison can't detect new service)
                        // The above diff will include the new service's files if they were added, so it's covered.
                    }

                    // Write the list of changed services to a file for later stages
                    def changedNames = changedServices.keySet() as List
                    writeFile file: 'changed-services.txt', text: changedNames.join(',')
                    writeFile file: 'has-changed-services.txt', text: changedNames.isEmpty() ? "false" : "true"
                    echo "Services to build: ${changedNames}"
                }
            }
        }

        stage('Check Java Version') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build, Test & Sonar Analysis') {
            when { expression { readFile('has-changed-services.txt').trim() == 'true' } }
            steps {
                script {
                    def changedNames = readFile('changed-services.txt').trim().split(',')
                    // Reload service configurations (we need the full config map)
                    def possibleServices = [
                        'api-gateway':   [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_API_GATEWAY ],
                        'user-service':  [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_USER_SERVICE ],
                        'movie-service': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_MOVIE_SERVICE ],
                        'email-service': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_EMAIL_SERVICE ],
                        'eureka-server': [ type: 'backend', buildFile: 'pom.xml', sonarKey: SONAR_PROJECT_EUREKA ],
                        'frontend':      [ type: 'frontend', buildFile: 'package.json', sonarKey: null ]
                    ]
                    def parallelStages = [:]
                    def builtServices = []

                    for (int i = 0; i < changedNames.size(); i++) {
                        def svc = changedNames[i]
                        def config = possibleServices[svc]
                        if (config == null) continue

                        parallelStages[svc] = {
                            stage("Build ${svc}") {
                                dir("services/${svc}") {
                                    if (config.type == 'backend') {
                                        sh 'mvn clean compile -DskipTests'
                                        if (config.sonarKey) {
                                            withSonarQubeEnv('sonarcloud') {
                                                sh "mvn sonar:sonar -Dsonar.projectKey=${config.sonarKey} -Dsonar.organization=functionalprojects"
                                            }
                                        }
                                        sh 'mvn package -DskipTests'
                                        sh "docker build --no-cache -t ${DOCKER_REGISTRY}/cinevision/${svc}:${GIT_COMMIT} ."
                                        sh "docker push ${DOCKER_REGISTRY}/cinevision/${svc}:${GIT_COMMIT}"
                                        sh "docker tag ${DOCKER_REGISTRY}/cinevision/${svc}:${GIT_COMMIT} ${DOCKER_REGISTRY}/cinevision/${svc}:latest"
                                        sh "docker push ${DOCKER_REGISTRY}/cinevision/${svc}:latest"
                                    } else if (config.type == 'frontend') {
                                        sh 'npm install'
                                        sh 'npm run build'
                                        sh "docker build --no-cache -t ${DOCKER_REGISTRY}/cinevision/${svc}:${GIT_COMMIT} ."
                                        sh "docker push ${DOCKER_REGISTRY}/cinevision/${svc}:${GIT_COMMIT}"
                                        sh "docker tag ${DOCKER_REGISTRY}/cinevision/${svc}:${GIT_COMMIT} ${DOCKER_REGISTRY}/cinevision/${svc}:latest"
                                        sh "docker push ${DOCKER_REGISTRY}/cinevision/${svc}:latest"
                                    }
                                    builtServices << svc
                                }
                            }
                        }
                    }
                    parallel parallelStages
                    writeFile file: 'built-services.txt', text: builtServices.join(',')
                    echo "Built services: ${builtServices}"
                }
            }
        }

        // Optional: Wait for SonarQube Quality Gate (commented out originally, can be uncommented and adapted)

        stage('Security Scan (Trivy)') {
            when { expression { readFile('has-changed-services.txt').trim() == 'true' } }
            steps {
                script {
                    def builtServices = readFile('built-services.txt').trim().split(',')
                    builtServices.each { serviceName ->
                        sh """
                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                -v trivy-cache:/root/.cache/trivy \
                                aquasec/trivy:0.55.0 \
                                image --scanners vuln --severity HIGH,CRITICAL --skip-java-db-update ${DOCKER_REGISTRY}/cinevision/${serviceName}:${GIT_COMMIT}
                        """
                    }
                }
            }
        }

        // ========== DEV ENVIRONMENT (develop branch) ==========
        stage('Update Kustomize (Dev)') {
            when {
                allOf {
                    branch 'develop'
                    expression { readFile('has-changed-services.txt').trim() == 'true' }
                }
            }
            steps {
                script {
                    def builtServices = readFile('built-services.txt').trim().split(',')
                    builtServices.each { serviceName ->
                        sh """
                            cd k8s/overlays/dev
                            kustomize edit set image ${serviceName}=${DOCKER_REGISTRY}/cinevision/${serviceName}:${GIT_COMMIT}
                        """
                    }
                    withCredentials([[
                        $class: 'UsernamePasswordMultiBinding',
                        credentialsId: 'github-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    ]]) {
                        sh """
                            git config user.email "jenkins@cinevision.com"
                            git config user.name "Jenkins"
                            git add k8s/overlays/dev/
                            git commit -m "Update dev images for commit ${GIT_COMMIT}" || echo "No changes to commit"
                            git push https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/functionalprojects/cinevision-platform.git HEAD:develop
                        """
                    }
                }
            }
        }

        stage('Deploy to Dev') {
            when { branch 'develop' }
            steps {
                echo "ArgoCD will automatically sync dev changes"
            }
        }

        // ========== STAGING ENVIRONMENT (release/* branches) ==========
        stage('Prepare Staging Deployment') {
            when { branch pattern: "release/.*", comparator: "REGEXP" }
            steps {
                script {
                    def builtServices = readFile('built-services.txt').trim().split(',')
                    builtServices.each { serviceName ->
                        sh """
                            cd k8s/overlays/staging
                            kustomize edit set image ${serviceName}=${DOCKER_REGISTRY}/cinevision/${serviceName}:${GIT_COMMIT}
                        """
                    }
                    withCredentials([[
                        $class: 'UsernamePasswordMultiBinding',
                        credentialsId: 'github-token',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    ]]) {
                        sh """
                            git config user.email "jenkins@cinevision.com"
                            git config user.name "Jenkins"
                            git add k8s/overlays/staging/
                            git commit -m "Update staging images for commit ${GIT_COMMIT}" || echo "No changes to commit"
                            git push https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/functionalprojects/cinevision-platform.git HEAD:${BRANCH_NAME}
                        """
                    }
                }
            }
        }

        stage('Manual Approval for Staging') {
            when { branch pattern: "release/.*", comparator: "REGEXP" }
            input {
                message "Deploy to staging environment?"
                ok "Deploy"
            }
            steps {
                script {
                    sh 'command -v argocd || curl -sSL -o /usr/local/bin/argocd https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64 && chmod +x /usr/local/bin/argocd'
                    sh "argocd app sync cinevision-staging --grpc-web"
                }
            }
        }

        stage('Integration Tests') {
            when { branch pattern: "release/.*", comparator: "REGEXP" }
            steps {
                script {
                    def gatewayUrl = sh(script: "kubectl get svc api-gateway -n cinevision -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo ''", returnStdout: true).trim()
                    if (!gatewayUrl) gatewayUrl = "http://api-gateway.cinevision.svc.cluster.local"
                    echo "Using API Gateway endpoint: ${gatewayUrl}"
                    dir('tests/integration') {
                        if (fileExists('package.json')) {
                            sh 'npm install'
                            sh "npm test -- --baseUrl=${gatewayUrl}"
                        } else {
                            echo "No integration tests found. Skipping."
                        }
                    }
                }
            }
        }

        stage('Performance Test') {
            when { branch pattern: "release/.*", comparator: "REGEXP" }
            steps {
                script {
                    def gatewayUrl = sh(script: "kubectl get svc api-gateway -n cinevision -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo ''", returnStdout: true).trim()
                    if (!gatewayUrl) gatewayUrl = "http://api-gateway.cinevision.svc.cluster.local"
                    echo "Using API Gateway endpoint for performance tests: ${gatewayUrl}"
                    if (fileExists('tests/performance/ticket-purchase-test.js')) {
                        sh """
                            docker run --rm -v \$(pwd)/tests/performance:/scripts loadimpact/k6:latest run /scripts/ticket-purchase-test.js --env BASE_URL=${gatewayUrl}
                        """
                    } else {
                        echo "Performance test script not found. Skipping."
                    }
                }
            }
        }

        stage('Security Scan (OWASP ZAP)') {
            when { branch pattern: "release/.*", comparator: "REGEXP" }
            steps {
                script {
                    def gatewayUrl = sh(script: "kubectl get svc api-gateway -n cinevision -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo ''", returnStdout: true).trim()
                    if (!gatewayUrl) gatewayUrl = "http://api-gateway.cinevision.svc.cluster.local"
                    echo "Running OWASP ZAP baseline scan against ${gatewayUrl}"
                    sh """
                        docker run --rm -v \$(pwd)/zap-reports:/zap/wrk:rw \
                            owasp/zap2docker-stable zap-baseline.py \
                            -t ${gatewayUrl} \
                            -r zap_report.html \
                            -w zap_report.md \
                            -J zap_report.json \
                            || echo "ZAP scan completed with warnings"
                    """
                    archiveArtifacts artifacts: 'zap-reports/**', fingerprint: true
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Build succeeded"
        }
        failure {
            echo "Build failed"
        }
    }
}